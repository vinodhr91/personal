<style>
/* ---------- Tokens ---------- */
:root {
  --paper: #EBF1EE;
  --surface: #F8FBF9;
  --tint: #DCE7E2;
  --ink: #10233F;
  --muted: #485A6E;
  --line: #C3D2CC;
  --accent: #0A6B57;
  --on-accent: #FFFFFF;
  --stamp: #B3372B;
  --bar-off: #9FB3AD;
  --sans: 'Bricolage Grotesque', 'Segoe UI', system-ui, -apple-system, sans-serif;
  --serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
  color-scheme: light;
}
:root[data-theme="dark"] {
  --paper: #0D1928;
  --surface: #132338;
  --tint: #1B3049;
  --ink: #E7EFF1;
  --muted: #A3B5C2;
  --line: #263B52;
  --accent: #52D0AA;
  --on-accent: #06231B;
  --stamp: #F0776A;
  --bar-off: #4B6479;
  color-scheme: dark;
}

/* ---------- Base ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 5rem; -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--serif);
  font-size: 1.0625rem;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}
img, svg { display: block; max-width: 100%; }
a { color: inherit; }
p { margin: 0 0 1rem; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
.wrap { width: min(1120px, 100% - 3rem); margin-inline: auto; }
.skip {
  position: absolute; left: -999px; top: 0; z-index: 50;
  background: var(--ink); color: var(--paper); padding: .7rem 1rem;
  font: 600 .95rem var(--sans); border-radius: 0 0 8px 0;
}
.skip:focus { left: 0; }

/* ---------- Header ---------- */
.top {
  position: sticky; top: 0; z-index: 30;
  background: var(--paper);
  background: color-mix(in srgb, var(--paper) 88%, transparent);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.top .wrap { display: flex; align-items: center; gap: .75rem; height: 4rem; }
.brand { display: flex; align-items: center; gap: .7rem; margin-right: auto; text-decoration: none; font: 700 1rem var(--sans); }
.brand .mono {
  display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
  border-radius: 8px; background: var(--accent); color: var(--on-accent);
  font: 800 .95rem var(--sans); letter-spacing: -.02em;
}
.nav { display: flex; align-items: center; gap: .15rem; }
.nav a {
  padding: .45rem .8rem; border-radius: 999px; text-decoration: none;
  color: var(--muted); font: 500 .95rem var(--sans); transition: background .15s, color .15s;
}
.nav a:hover { color: var(--ink); background: var(--tint); }
.nav a[aria-current="true"] { color: var(--ink); background: var(--tint); font-weight: 600; }
.icon-btn {
  display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
  border-radius: 10px; border: 1px solid var(--line); background: transparent;
  color: var(--ink); cursor: pointer; transition: background .15s;
}
.icon-btn:hover { background: var(--tint); }
.menu-btn { display: none; }
.theme-btn .sun { display: none; }
:root[data-theme="dark"] .theme-btn .sun { display: block; }
:root[data-theme="dark"] .theme-btn .moon { display: none; }

/* ---------- Hero ---------- */
.hero { position: relative; overflow: hidden; padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem); }
.guil {
  position: absolute; top: 0; right: 0; height: 100%; width: 70%;
  fill: none; stroke: var(--accent); stroke-width: .7; opacity: .5;
  pointer-events: none;
  -webkit-mask-image: linear-gradient(to left, #000 25%, transparent 95%);
  mask-image: linear-gradient(to left, #000 25%, transparent 95%);
}
.hero-grid {
  position: relative; z-index: 1;
  display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .9fr);
  gap: clamp(2rem, 5vw, 4.5rem); align-items: end;
}
.hero h1 {
  margin: 0 0 1.4rem;
  font: 800 clamp(2.8rem, 10.5vw, 5.4rem)/.92 var(--sans);
  font-stretch: 85%;
  letter-spacing: -.035em;
}
.hero h1 span { display: block; }
.role-line { font: 600 clamp(1.05rem, 2.4vw, 1.3rem)/1.35 var(--sans); margin: 0 0 1rem; }
.lede { font-size: 1.2rem; max-width: 34rem; color: var(--muted); margin-bottom: 1.8rem; }
.cta-row { display: flex; flex-wrap: wrap; gap: .75rem; }

.btn {
  display: inline-flex; align-items: center; justify-content: center;
  font: 600 1rem var(--sans); padding: .8rem 1.25rem;
  border-radius: 10px; border: 1.5px solid var(--ink);
  color: var(--ink); background: transparent; text-decoration: none; cursor: pointer;
  transition: background .15s, color .15s, filter .15s;
}
.btn:hover { background: var(--tint); }
.btn-primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
.btn-primary:hover { background: var(--accent); filter: brightness(1.1); }

/* passbook-style summary */
.glance {
  background: var(--surface);
  border: 1px solid var(--line);
  border-left: 12px solid var(--accent);
  border-radius: 4px 12px 12px 4px;
  padding: 1.3rem 1.5rem 1rem;
}
.glance-title { margin: 0 0 .4rem; font: 700 1.05rem var(--sans); }
.glance dl { margin: 0; }
.glance .row {
  display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: .75rem;
  padding: .75rem 0; border-top: 1px dashed var(--line);
}
.glance dt { font: 500 .92rem/1.6 var(--sans); color: var(--muted); }
.glance dd { margin: 0; font-size: 1rem; line-height: 1.5; }

/* ---------- Sections ---------- */
.section { padding: clamp(3.5rem, 8vw, 6rem) 0; border-top: 1px solid var(--line); }
.sec-grid { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4.5rem); }
.sec-head { position: sticky; top: 6rem; align-self: start; }
.sec-head h2 { margin: 0 0 .7rem; font: 700 clamp(1.8rem, 3vw, 2.35rem)/1.1 var(--sans); letter-spacing: -.02em; }
.sec-head p { color: var(--muted); font: 400 .98rem/1.55 var(--sans); }
.link-btn {
  background: none; border: 0; padding: .25rem 0; cursor: pointer;
  font: 600 .95rem var(--sans); color: var(--accent);
  text-decoration: underline; text-underline-offset: .2em;
}
.prose { max-width: 40rem; }
.prose p { font-size: 1.125rem; line-height: 1.75; }

/* ---------- Results ---------- */
.result {
  display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
  gap: 1rem 2rem; padding: 1.7rem 0; border-top: 1px solid var(--line);
}
.result:first-child { border-top: 0; padding-top: 0; }
.fig { font: 800 clamp(2.4rem, 4.5vw, 3.2rem)/1 var(--sans); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
.fig small { display: block; margin-top: .4rem; font: 500 .92rem/1.3 var(--sans); letter-spacing: 0; color: var(--muted); }
.result h3 { margin: 0 0 .4rem; font: 600 1.2rem/1.3 var(--sans); }
.result p { margin: 0; color: var(--muted); max-width: 36rem; }

.bars { margin-top: 1.1rem; max-width: 30rem; display: grid; gap: .55rem; }
.bar { display: grid; grid-template-columns: 5.2rem minmax(0, 1fr) 2.2rem; align-items: center; gap: .75rem; font: 500 .92rem var(--sans); }
.bar b { font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
.track { height: .8rem; background: var(--tint); border-radius: 3px; overflow: hidden; }
.track i { display: block; height: 100%; width: var(--w); background: var(--bar-off); border-radius: 3px; }
.bar.hit .track i { background: var(--accent); }

.meter { margin-top: 1.1rem; max-width: 30rem; }
.meter .track i { background: var(--accent); }
.scale { display: flex; justify-content: space-between; margin-top: .3rem; font: 500 .85rem var(--sans); color: var(--muted); font-variant-numeric: tabular-nums; }
.audit { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 1.2rem 2rem; }
.stamp {
  display: inline-block; margin: .3rem .4rem 0 0;
  font: 800 1rem/1 var(--sans); letter-spacing: .08em;
  color: var(--stamp); border: 2px solid var(--stamp); outline: 1px solid var(--stamp); outline-offset: 3px;
  padding: .5rem .85rem; border-radius: 4px; transform: rotate(-5deg); opacity: .92;
}

/* one-time reveal, only when motion is allowed (class added by script) */
.anim .track i { width: 0; transition: width 1.1s cubic-bezier(.2, .7, .2, 1); }
.anim .in .track i { width: var(--w); }
.anim .stamp { opacity: 0; transform: rotate(-5deg) scale(1.8); }
.anim .in .stamp { opacity: .92; transform: rotate(-5deg) scale(1); transition: opacity .2s .7s, transform .35s cubic-bezier(.3, 1.4, .5, 1) .7s; }

/* ---------- Experience ---------- */
.org { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem 1rem; margin: 0 0 .6rem; }
.org h3 { margin: 0; font: 700 1.4rem var(--sans); letter-spacing: -.01em; }
.org p { margin: 0; color: var(--muted); font: 400 .95rem var(--sans); }
.org-block + .org-block { margin-top: 3.2rem; }
.roles { list-style: none; margin: 0; padding: 0 0 0 1.5rem; border-left: 2px solid var(--line); }
.role { position: relative; }
.role + .role { border-top: 1px solid var(--line); }
.role::before {
  content: ""; position: absolute; left: calc(-1.5rem - 7px); top: 1.55rem;
  width: 12px; height: 12px; border-radius: 50%;
  background: var(--paper); border: 2px solid var(--accent);
}
.role summary {
  display: grid; grid-template-columns: minmax(0, 1fr) auto 1.5rem; align-items: center; gap: .2rem 1rem;
  padding: 1.05rem 0; cursor: pointer; list-style: none;
}
.role summary::-webkit-details-marker { display: none; }
.role-title { font: 600 1.12rem/1.3 var(--sans); }
.role-place { display: block; font: 400 .9rem var(--sans); color: var(--muted); }
.role-when { font: 500 .92rem var(--sans); color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
.chev { transition: transform .2s; color: var(--muted); }
.role details[open] .chev { transform: rotate(180deg); }
.role-body { padding: 0 0 1.4rem; max-width: 42rem; }
.role-body p { margin: 0; }
.role-body ul { list-style: none; margin: 0; padding: 0; }
.role-body li { position: relative; padding-left: 1.3rem; margin: .6rem 0; }
.role-body li::before { content: ""; position: absolute; left: 0; top: .82em; width: .6rem; height: 2px; background: var(--accent); }

/* ---------- Skills and credentials ---------- */
.two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.6rem 3rem; }
.two-col .wide { grid-column: 1 / -1; }
.block-title { margin: 0; font: 700 1.15rem var(--sans); }
.index { list-style: none; margin: .7rem 0 0; padding: 0; }
.index li { padding: .7rem 0; border-bottom: 1px dashed var(--line); font: 600 1.02rem/1.4 var(--sans); break-inside: avoid; }
.index li:first-child { border-top: 1px dashed var(--line); }
.index li span { display: block; margin-top: .1rem; font: 400 .95rem/1.5 var(--serif); color: var(--muted); }
.wide .index { columns: 2; column-gap: 3rem; }

/* ---------- Contact ---------- */
.mail {
  display: inline-block; margin: 0 0 1.6rem;
  font: 700 clamp(1.35rem, 3.6vw, 2.4rem)/1.2 var(--sans); letter-spacing: -.02em;
  text-decoration: underline; text-decoration-color: var(--accent);
  text-decoration-thickness: 3px; text-underline-offset: .25em; overflow-wrap: anywhere;
}
.contact-meta { margin: 1.6rem 0 0; color: var(--muted); font: 400 1rem var(--sans); }

.foot { border-top: 1px solid var(--line); padding: 1.6rem 0 2.6rem; font: 400 .92rem var(--sans); color: var(--muted); }
.foot .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; }

.toast {
  position: fixed; left: 50%; bottom: 1.5rem; z-index: 60;
  transform: translate(-50%, 16px); opacity: 0; pointer-events: none;
  background: var(--ink); color: var(--paper);
  padding: .7rem 1.1rem; border-radius: 8px; font: 500 .95rem var(--sans);
  transition: opacity .2s, transform .2s;
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }

/* ---------- Responsive ---------- */
@media (max-width: 960px) {
  .hero-grid { grid-template-columns: minmax(0, 1fr); align-items: start; }
  .guil { width: 100%; opacity: .35; }
  .sec-grid { grid-template-columns: minmax(0, 1fr); }
  .sec-head { position: static; }
  .menu-btn { display: grid; }
  .nav {
    display: none; position: absolute; top: 100%; left: 0; right: 0;
    flex-direction: column; align-items: stretch; gap: .1rem;
    background: var(--paper); border-bottom: 1px solid var(--line);
    padding: .5rem 1.5rem 1rem;
  }
  .nav.open { display: flex; }
  .nav a { padding: .8rem .9rem; border-radius: 8px; }
}
@media (max-width: 640px) {
  .brand-name { display: none; }
  .result { grid-template-columns: minmax(0, 1fr); gap: .6rem; }
  .two-col { grid-template-columns: minmax(0, 1fr); }
  .wide .index { columns: 1; }
  .role summary { grid-template-columns: minmax(0, 1fr) 1.5rem; }
  .role-when { grid-row: 2; grid-column: 1; }
  .chev { grid-row: 1 / span 2; grid-column: 2; }
  .glance .row { grid-template-columns: 1fr; gap: 0; }
  .bar { grid-template-columns: 4.6rem minmax(0, 1fr) 2rem; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { transition: none !important; animation: none !important; }
}
@media print {
  .top, .guil, .toast, .link-btn { display: none !important; }
  body { background: #fff; color: #000; }
}
</style>
